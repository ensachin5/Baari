{
  "name": "baari",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.11.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "npm --prefix apps/web run dev",
    "dev:mobile": "npm --prefix apps/mobile start",
    "mobile": "npm --prefix apps/mobile start",
    "web": "npm --prefix apps/web run dev",
    "start": "npm --prefix apps/mobile start",
    "build": "turbo build",
    "build:web": "npm --prefix apps/web run build",
    "build:mobile": "npm --prefix apps/mobile run typecheck",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "db:generate": "npm --prefix packages/db run db:generate",
    "db:migrate": "npm --prefix packages/db run db:migrate",
    "db:push": "npm --prefix packages/db run db:push",
    "db:studio": "npm --prefix packages/db run db:studio"
  },
  "dependencies": {
    "drizzle-orm": "^0.39.3"
  },
  "devDependencies": {
    "turbo": "^2.4.4"
  }
}
