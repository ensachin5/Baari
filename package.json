{
  "name": "baari",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --prefix apps/web run dev",
    "dev:web": "npm --prefix apps/web run dev",
    "dev:mobile": "npm --prefix apps/mobile start",
    "web": "npm --prefix apps/web run dev",
    "mobile": "npm --prefix apps/mobile start",
    "start": "npm --prefix apps/mobile start",
    "build": "npm --prefix apps/web run build",
    "build:web": "npm --prefix apps/web run build",
    "typecheck": "npm run typecheck --workspaces",
    "db:generate": "npm --prefix packages/db run db:generate",
    "db:migrate": "npm --prefix packages/db run db:migrate",
    "db:push": "npm --prefix packages/db run db:push",
    "db:studio": "npm --prefix packages/db run db:studio"
  },
  "dependencies": {
    "drizzle-orm": "^0.39.3"
  }
}
