{
  "expo": {
    "name": "Baari",
    "slug": "baari",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/baari-icon-solid.png",
    "scheme": "baari",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#152447"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.baari.mobile",
      "icon": "./assets/baari-icon-solid.png"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/baari-icon-foreground.png",
        "backgroundColor": "#152447"
      },
      "package": "app.baari.mobile",
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/baari-logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-sharing",
      "expo-dev-client",
      "expo-updates"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0549f4c0-08c0-4e3d-b4cf-ddb1fbda3e74"
      }
    },
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/0549f4c0-08c0-4e3d-b4cf-ddb1fbda3e74"
    }
  }
}
